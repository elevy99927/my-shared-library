@Library('my-shared-library') _

import com.levys.co.il.lib.DockerHelper

pipeline {
    agent any

    stages {
        stage('Build Docker Image') {
            steps {
                script {
                    def docker = new DockerHelper(this)
                    docker.buildImage('my-app', '1.0.0')
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    def docker = new DockerHelper(this)
                    docker.pushImage('my-app', '1.0.0')
                }
            }
        }
    }
}
